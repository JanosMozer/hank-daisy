<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Meta Wearables SDK Configuration -->
	<key>MWDAT</key>
	<dict>
		<!-- App Link URL Scheme (should match the scheme in your app's URL configuration) -->
		<key>AppLinkURLScheme</key>
		<string>hankdaisy</string>

		<!-- Development Mode: Use 0 for developer mode, set to real value for production -->
		<key>MetaAppID</key>
		<string>0</string>

		<!-- ClientToken: Leave blank for development, set from Wearables Developer Center for production -->
		<key>ClientToken</key>
		<string></string>

		<!-- TeamID: Your Apple Developer Team ID (optional, for production) -->
		<key>TeamID</key>
		<string></string>

		<!-- Analytics: Opt out if desired -->
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<false/>
		</dict>
	</dict>

	<!-- Custom URL Scheme for glasses registration callback -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hankdaisy</string>
			</array>
		</dict>
	</array>

	<!-- Allow opening the Meta AI app -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>

	<!-- External Accessory Protocol (Meta glasses) -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>

	<!-- Background Modes (required for glasses connection to survive backgrounding) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
		<string>processing</string>
	</array>

	<key>MWDAT.AppLinkURLScheme</key>
	<string>hankdaisy</string>
	<key>MWDAT.MetaAppID</key>
	<string></string>
	<key>MWDAT.TeamID</key>
	<string>VDT297FLZ9</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.meta.wearable.hankdaisy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hankdaisy</string>
			</array>
		</dict>
	</array>

	<!-- Microphone Permission -->
	<key>NSMicrophoneUsageDescription</key>
	<string>We need access to your microphone to listen for commands and record your questions for Hank.</string>
	
	<!-- Speech Recognition Permission -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>We need speech recognition to transcribe your voice commands.</string>


	<!-- Bluetooth Permission -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>We need Bluetooth to connect to your Oakley Meta Vanguard glasses.</string>

	<!-- Local Network Permission (for agent server discovery) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>We need access to your local network to discover glasses and talk to the agent.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_meta-wearable._tcp</string>
		<string>_meta-wearable._udp</string>
		<string>_bonjour._tcp</string>
	</array>

	<!-- Camera Permission (optional, for MockDeviceKit testing) -->
	<key>NSCameraUsageDescription</key>
	<string>HankDaisy needs the camera for testing without physical glasses.</string>

	<!-- Photo Library Permission (optional, for saving captured frames) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>We need access to save captured diagnostic images.</string>
</dict>
</plist>
