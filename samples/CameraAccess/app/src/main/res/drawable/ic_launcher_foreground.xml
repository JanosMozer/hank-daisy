<?xml version="1.0" encoding="utf-8"?>
<!--
    Hank & Daisy launcher-icon foreground.

    Adaptive-icon viewport is 108x108; the safe zone after system masks is
    the centred 66x66 square. We render a vertically-stacked H · & · D
    monogram in purple (#7C3AED) on the white background, deliberately
    smaller than the safe zone so the icon has breathing room after the
    launcher applies its circle / squircle mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- H (top, x 45..63, y 28..46) -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M45,28 L48,28 L48,35 L60,35 L60,28 L63,28 L63,46 L60,46 L60,38 L48,38 L48,46 L45,46 Z" />

    <!-- & (middle, stylised as a figure-8 of two rings at x 49..59, y 50..58) -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M54,52 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z M54,56.5 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" />

    <!-- D (bottom, x 45..63, y 62..80, evenOdd gives the hollow bowl) -->
    <path
        android:fillColor="#7C3AED"
        android:fillType="evenOdd"
        android:pathData="M45,62 L54,62 C60,62 63,66 63,71 C63,76 60,80 54,80 L45,80 Z M48,65 L54,65 C58,65 60,68 60,71 C60,74 58,77 54,77 L48,77 Z" />
</vector>
