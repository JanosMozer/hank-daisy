<?xml version="1.0" encoding="utf-8"?>
<!--
    Hank & Daisy launcher-icon foreground.

    Adaptive-icon viewport is 108x108; the safe zone (visible after
    system masks apply) is the centred 66x66 square (x 21..87, y 21..87).

    We render a purple "H&D" monogram inside the safe zone. Full
    "Hank & Daisy" text would be illegible at launcher-icon sizes; the
    long-form logo is used on the Splash / Home screens where there is
    room for it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- H -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M24,30 L32,30 L32,52 L46,52 L46,30 L54,30 L54,78 L46,78 L46,60 L32,60 L32,78 L24,78 Z" />

    <!-- & (stylised as two stacked rings — readable at small sizes) -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M62,44 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z M62,65 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />

    <!-- D (with hollow interior via evenOdd fill) -->
    <path
        android:fillColor="#7C3AED"
        android:fillType="evenOdd"
        android:pathData="M74,30 L82,30 C91,30 96,40 96,54 C96,68 91,78 82,78 L74,78 Z M80,38 L82,38 C86,38 90,46 90,54 C90,62 86,70 82,70 L80,70 Z" />
</vector>
