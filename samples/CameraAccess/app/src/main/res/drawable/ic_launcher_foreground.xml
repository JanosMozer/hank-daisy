<?xml version="1.0" encoding="utf-8"?>
<!--
    Hank & Daisy launcher-icon foreground.

    Vertical wordmark: "HANK" / "&" / "DAISY" in purple on white.
    VectorDrawable has no text support, so each glyph is constructed as
    a 4×5 (H/A/N/K/D/S/Y) or 2×5 (I) pixel grid, scaled 2× into the
    108×108 adaptive-icon viewport. Rough at very small sizes but the
    wordmark is still recognisable, and this is what the user asked for
    ("yes the text might be smaller but it should be fine").

    Grid: each "pixel" is 2×2 units, scale 2.
    Line Y-spans:
      HANK : y 22..32
      &    : y 40..50
      DAISY: y 58..68
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#7C3AED"
        android:pathData="
            M35,22 h2 v10 h-2 Z  M41,22 h2 v10 h-2 Z  M35,26 h8 v2 h-8 Z
            M47,22 h4 v2 h-4 Z   M45,24 h2 v2 h-2 Z   M51,24 h2 v2 h-2 Z
            M45,26 h8 v2 h-8 Z   M45,28 h2 v4 h-2 Z   M51,28 h2 v4 h-2 Z
            M55,22 h2 v10 h-2 Z  M61,22 h2 v10 h-2 Z
            M57,24 h2 v2 h-2 Z   M59,26 h2 v2 h-2 Z
            M65,22 h2 v10 h-2 Z  M71,22 h2 v2 h-2 Z
            M69,24 h2 v2 h-2 Z   M67,26 h2 v2 h-2 Z
            M69,28 h2 v2 h-2 Z   M71,30 h2 v2 h-2 Z

            M52,40 h4 v2 h-4 Z   M50,42 h2 v2 h-2 Z   M54,42 h2 v2 h-2 Z
            M52,44 h2 v2 h-2 Z   M50,46 h2 v2 h-2 Z   M54,46 h2 v2 h-2 Z
            M52,48 h4 v2 h-4 Z

            M33,58 h6 v2 h-6 Z   M33,66 h6 v2 h-6 Z
            M33,60 h2 v6 h-2 Z   M39,60 h2 v6 h-2 Z
            M45,58 h4 v2 h-4 Z   M43,60 h2 v2 h-2 Z   M49,60 h2 v2 h-2 Z
            M43,62 h8 v2 h-8 Z   M43,64 h2 v4 h-2 Z   M49,64 h2 v4 h-2 Z
            M53,58 h2 v10 h-2 Z
            M59,58 h6 v2 h-6 Z   M57,60 h2 v2 h-2 Z   M59,62 h4 v2 h-4 Z
            M63,64 h2 v2 h-2 Z   M57,66 h6 v2 h-6 Z
            M67,58 h2 v4 h-2 Z   M73,58 h2 v4 h-2 Z   M69,62 h4 v6 h-4 Z
        " />
</vector>
